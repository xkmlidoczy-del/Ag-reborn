+        /** Apply a procedural rotation for this draw, including its emissive pass. */
+        private static final class RenderRotation {
+            private GeoBone bone;
+            private float x, y, z;
+            private boolean rotationChanged;
+
+            void apply(GeoBone target, float pitch, float yaw, float roll) {
+                if (target == null || (pitch == 0f && yaw == 0f && roll == 0f)) return;
+                bone = target;
+                x = target.getRotX();
+                y = target.getRotY();
+                z = target.getRotZ();
+                rotationChanged = target.hasRotationChanged();
+                target.updateRotation(x + pitch, y + yaw, z + roll);
+            }
+
+            void restore() {
+                if (bone == null) return;
+                bone.updateRotation(x, y, z);
+                if (!rotationChanged) {
+                    // Leaving GeckoLib's rotation marker set prevents unkeyframed bones from resetting.
+                    boolean positionChanged = bone.hasPositionChanged();
+                    boolean scaleChanged = bone.hasScaleChanged();
+                    bone.resetStateChanges();
+                    if (positionChanged) bone.markPositionAsChanged();
+                    if (scaleChanged) bone.markScaleAsChanged();
+                }
+                bone = null;
+            }
+        }
